# Copy this file to .env and fill in the values. Do not commit .env.
# Create an API token with scopes at https://id.atlassian.com/manage-profile/security/api-tokens
# Include read:jira-work, read:jira-user, and write:jira-work.

JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ

# Optional. The description section label. Defaults to "Root Cause".
# JIRA_ROOT_CAUSE_LABEL=Root Cause

# Optional. Defaults to Bug when omitted.
JIRA_ISSUE_TYPE=Bug

# Optional. Local embedding model and Chroma directory.
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# CHROMA_PATH=.chroma

# Optional. When set, a clear historical match is phrased by Gemini.
# A weak match always uses the stored similarity scores and does not call the model.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
